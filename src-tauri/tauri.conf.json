{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MangNotch",
  "version": "1.2.0",
  "identifier": "com.mangnotch.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "title": "",
        "url": "notch.html",
        "width": 1100,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true,
        "dragDropEnabled": true
      },
      {
        "label": "control",
        "title": "MangNotch Control Center",
        "url": "control.html",
        "width": 540,
        "height": 580,
        "resizable": false,
        "center": true,
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "vestiapani",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
