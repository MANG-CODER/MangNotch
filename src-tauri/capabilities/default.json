{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability untuk semua jendela notch (multi-monitor) dan control",
  "windows": ["notch*", "control"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-close"
  ]
}
